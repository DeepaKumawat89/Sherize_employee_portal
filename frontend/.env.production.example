# Vite embeds these public Firebase web-app settings at build time.
# Copy this file to .env.production and use the same Firebase Web App values
# configured for the existing Sherize portals.
VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=sherize-bpo.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=sherize-bpo
VITE_FIREBASE_STORAGE_BUCKET=sherize-bpo.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_web_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id
VITE_FIREBASE_FUNCTIONS_REGION=us-central1
